generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  slug         String   @unique // "scott" | "kurtis" — stable internal id, independent of display name/email
  name         String
  email        String   @unique
  passwordHash String?
  title        String   @default("")
  bio          String   @default("")
  strengths    String[] @default([])
  createdAt    DateTime @default(now())

  submissions       Submission[]
  ratings           Rating[]
  resetTokens       PasswordResetToken[]
  nudgesSent        Nudge[]           @relation("NudgeFrom")
  nudgesReceived    Nudge[]           @relation("NudgeTo")
  pushSubscriptions PushSubscription[]
  matchesAsA        Match[]           @relation("MatchPlayerA")
  matchesAsB        Match[]           @relation("MatchPlayerB")
  forfeitedMatches  Match[]           @relation("MatchForfeitedBy")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Settings {
  id                    Int    @id @default(1)
  deadlineDay           String @default("Sunday")
  deadlineTime          String @default("20:00")
  briefDropDay          String @default("Monday")
  rerollTokensPerSeason Int    @default(2)
  seasonLength          Int    @default(8)
  // Weeks between rounds — 1 = weekly, 2 = fortnightly. Rounds now chain
  // continuously (the next one opens the instant the previous one locks,
  // see rolloverIfNeeded in weeks.js), so this only stretches how far out
  // the deadline lands, not briefDropDay — kept for the initial bootstrap
  // week only at this point.
  cadenceWeeks          Int    @default(1)
}

model Week {
  id                    Int      @id @default(autoincrement())
  number                Int      @unique
  season                Int
  types                 String[]
  brief                 String
  inspiration           String
  opened                DateTime
  deadline              DateTime
  rerollsUsedThisSeason Int      @default(0)
  archivedAt            DateTime?

  matches Match[]

  @@index([deadline])
}

// One pairing for a given week. A bye or a forfeit-vacated slot is
// represented the same way — playerBId (or playerAId) is simply null —
// so /api/matches/:id/join can fill either case with one code path.
model Match {
  id              Int       @id @default(autoincrement())
  weekId          Int
  week            Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  playerAId       Int?
  playerA         User?     @relation("MatchPlayerA", fields: [playerAId], references: [id], onDelete: SetNull)
  playerBId       Int?
  playerB         User?     @relation("MatchPlayerB", fields: [playerBId], references: [id], onDelete: SetNull)
  forfeitedUserId Int?
  forfeitedUser   User?     @relation("MatchForfeitedBy", fields: [forfeitedUserId], references: [id], onDelete: SetNull)
  lockedAt        DateTime? // both submitted, or deadline passed
  finalizedAt     DateTime? // lockedAt + 24h — combined score locks in, counts toward standings
  reminderSentAt  DateTime? // 24h-before-deadline nudge, fired once per match
  createdAt       DateTime  @default(now())

  submissions Submission[]
  ratings     Rating[]
  verdict     Verdict?
  nudges      Nudge[]

  @@index([weekId])
}

model Submission {
  id          Int      @id @default(autoincrement())
  matchId     Int
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoPath   String
  title       String   @default("")
  note        String   @default("")
  caption     String   @default("")
  submittedAt DateTime @default(now())

  @@unique([matchId, userId])
}

model Rating {
  id         Int      @id @default(autoincrement())
  matchId    Int
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raterId    Int // the user who submitted this rating — it scores the OTHER player's photo
  rater      User     @relation(fields: [raterId], references: [id], onDelete: Cascade)
  scores     Json // { interpretation, composition, mood, originality, execution }
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([matchId, raterId])
}

model Verdict {
  id                 Int      @id @default(autoincrement())
  matchId            Int      @unique
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  source             String // "ai" | "guest"
  judgeName          String   @default("")
  // critique/scores are keyed by submission id (as a JSON string key) — the
  // A/B anonymization is only a presentation trick used while calling the
  // judge; the server resolves it back to real submissions before storing.
  critique           Json // { [submissionId]: text, comparison, why }
  scores             Json // { [submissionId]: { interpretation, composition, mood, originality, execution } }
  winnerSubmissionId Int? // null = tie
  awards             String[] @default([])
  createdAt          DateTime @default(now())
}

model Nudge {
  id         Int      @id @default(autoincrement())
  matchId    Int
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  fromUserId Int
  fromUser   User     @relation("NudgeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   Int
  toUser     User     @relation("NudgeTo", fields: [toUserId], references: [id], onDelete: Cascade)
  sentAt     DateTime @default(now())

  @@index([matchId, toUserId, sentAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
