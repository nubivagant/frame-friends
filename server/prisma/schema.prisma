generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  slug         String   @unique // "scott" | "kurtis" — stable internal id, independent of display name/email
  name         String
  email        String   @unique
  passwordHash String?
  title        String   @default("")
  bio          String   @default("")
  strengths    String[] @default([])
  createdAt    DateTime @default(now())

  submissions       Submission[]
  ratings           Rating[]
  resetTokens       PasswordResetToken[]
  nudgesSent        Nudge[]           @relation("NudgeFrom")
  nudgesReceived    Nudge[]           @relation("NudgeTo")
  pushSubscriptions PushSubscription[]
  matchSlots        MatchParticipant[] @relation("ParticipantUser")
  forfeitedSlots    MatchParticipant[] @relation("ParticipantForfeitedBy")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Settings {
  id                    Int    @id @default(1)
  deadlineDay           String @default("Sunday")
  deadlineTime          String @default("20:00")
  briefDropDay          String @default("Monday")
  rerollTokensPerSeason Int    @default(2)
  seasonLength          Int    @default(8)
  // Weeks between rounds — 1 = weekly, 2 = fortnightly. Rounds now chain
  // continuously (the next one opens the instant the previous one locks,
  // see rolloverIfNeeded in weeks.js), so this only stretches how far out
  // the deadline lands, not briefDropDay — kept for the initial bootstrap
  // week only at this point.
  cadenceWeeks          Int    @default(1)
}

model Week {
  id                    Int      @id @default(autoincrement())
  number                Int      @unique
  season                Int
  types                 String[]
  brief                 String
  inspiration           String
  opened                DateTime
  deadline              DateTime
  rerollsUsedThisSeason Int      @default(0)
  archivedAt            DateTime?

  matches Match[]

  @@index([deadline])
}

// One round for a given week — 2 participants for a duel, up to 4 for a
// group challenge (see createMatchesForWeek in weeks.js: groups run through
// 4 active players, random 1v1 pairing kicks in at 5+). A duel is just a
// group of two; nothing downstream (scoring, standings) special-cases it.
model Match {
  id              Int       @id @default(autoincrement())
  weekId          Int
  week            Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  lockedAt        DateTime? // everyone submitted, or deadline passed
  finalizedAt     DateTime? // lockedAt + 24h — combined score locks in, counts toward standings
  reminderSentAt  DateTime? // 24h-before-deadline nudge, fired once per match
  createdAt       DateTime  @default(now())

  participants MatchParticipant[]
  submissions  Submission[]
  ratings      Rating[]
  verdict      Verdict?
  nudges       Nudge[]

  @@index([weekId])
}

// One slot in a Match. A bye or a forfeit-vacated slot is represented the
// same way — userId is simply null — so /api/matches/:id/join can fill
// either case with one code path. forfeitedUserId is a separate audit
// field: who vacated this slot, if anyone (kept even once someone else
// fills it back in, though today nobody outside a full group can).
model MatchParticipant {
  id              Int    @id @default(autoincrement())
  matchId         Int
  match           Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId          Int?
  user            User?  @relation("ParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  forfeitedUserId Int?
  forfeitedUser   User?  @relation("ParticipantForfeitedBy", fields: [forfeitedUserId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([userId])
}

model Submission {
  id          Int      @id @default(autoincrement())
  matchId     Int
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoPath   String
  title       String   @default("")
  note        String   @default("")
  caption     String   @default("")
  submittedAt DateTime @default(now())

  ratings Rating[]

  @@unique([matchId, userId])
}

model Rating {
  id           Int        @id @default(autoincrement())
  matchId      Int
  match        Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raterId      Int // the user who submitted this rating
  rater        User       @relation(fields: [raterId], references: [id], onDelete: Cascade)
  submissionId Int // which submission this rating scores — needed once a match can have more than one "other" photo
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  scores       Json // { interpretation, composition, mood, originality, execution }
  note         String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([matchId, raterId, submissionId])
}

model Verdict {
  id        Int      @id @default(autoincrement())
  matchId   Int      @unique
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  source    String // "ai" | "guest"
  judgeName String   @default("")
  // critique/scores are keyed by submission id (as a JSON string key), for
  // however many submissions the match has (2 for a duel, up to 4 for a
  // group) — the A/B/C/D anonymization is only a presentation trick used
  // while calling the judge; the server resolves it back to real
  // submissions before storing. No stored winner/awards — those are
  // derived downstream from combined AI+peer scores (computeMatchResult in
  // weeks.js), not from the AI's raw per-photo take.
  critique  Json // { [submissionId]: text, comparison }
  scores    Json // { [submissionId]: { interpretation, composition, mood, originality, execution } }
  createdAt DateTime @default(now())
}

model Nudge {
  id         Int      @id @default(autoincrement())
  matchId    Int
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  fromUserId Int
  fromUser   User     @relation("NudgeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   Int
  toUser     User     @relation("NudgeTo", fields: [toUserId], references: [id], onDelete: Cascade)
  sentAt     DateTime @default(now())

  @@index([matchId, toUserId, sentAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
