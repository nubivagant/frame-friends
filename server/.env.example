# Copy this to .env for local dev, and set the same keys as Railway
# variables for the deployed service (DATABASE_URL is provided
# automatically by Railway's Postgres plugin — don't set it by hand there).

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/framefriends"

# Long random string used to sign session cookies.
SESSION_SECRET="change-me-to-a-long-random-string"

# The two baseline seeded accounts (created on every boot via seed.js).
# Any further players are added with server/src/scripts/invite-user.js.
# Real email addresses — used for the password-set/reset flow via Resend.
SCOTT_EMAIL="scott@example.com"
KURTIS_EMAIL="kurtis@example.com"

# Anthropic API key, used server-side for automatic weekly AI judging.
ANTHROPIC_API_KEY=""

# Resend API key + the "from" address to send password-set/reset emails from.
RESEND_API_KEY=""
RESEND_FROM="Frame Friends <onboarding@resend.dev>"

# Public URL of the deployed app, used to build links in emails.
APP_URL="http://localhost:3000"

# Where uploaded photos are written. On Railway this should be the mount
# path of the attached Volume (e.g. /data/photos); locally it defaults to
# a folder inside the repo.
PHOTOS_DIR="./.devdata/photos"

PORT=3000

# Web push (nudges, new-brief/reminder/reveal-ready notifications). Generate
# once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# and reuse the same pair forever — regenerating invalidates every existing
# browser subscription. Not a third-party account; push itself is a
# no-signup crypto handshake with the browser vendor's own infrastructure.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:scottshirbin@gmail.com"
